<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qpokoyOfflineOverlay"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#070C14" android:clickable="true" android:focusable="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="qPokoy" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:id="@+id/offlineMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center" android:text="@string/offline_message"
                android:textColor="#FFFFFF" android:textSize="20sp" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/offlineDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:text="@string/offline_detail"
                android:textColor="#A4B1C5" android:textSize="15sp"/>
            <Button android:id="@+id/offlineRetry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:minWidth="144dp" android:minHeight="48dp"
                android:paddingLeft="24dp" android:paddingRight="24dp" android:text="@string/offline_retry"
                android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/offline_button" android:backgroundTint="#1967D2"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
